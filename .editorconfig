root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 2
max_line_length = 120

[*.{xml,gradle}]
indent_size = 4

[*.{md,txt}]
indent_size = 2

[*.sh]
indent_size = 2

[gradle-wrapper.properties]
indent_size = 2
